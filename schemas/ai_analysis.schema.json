{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hooshyar AI Analysis",
  "description": "Structural contract for grounded-theory analysis and its explicit paradigm diagram.",
  "type": "object",
  "required": [
    "schema_version",
    "software",
    "analysis_method",
    "project_id",
    "analysis_status",
    "analysis_metadata",
    "concept_reviews",
    "categories",
    "central_phenomenon",
    "paradigm_model",
    "diagram",
    "relationships",
    "researcher_review",
    "quality_audit"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "software": {"const": "HOOSHYAR"},
    "analysis_method": {"const": "Strauss_Corbin_Grounded_Theory"},
    "project_id": {"type": "string"},
    "analysis_status": {"enum": ["complete", "incomplete"]},
    "analysis_metadata": {
      "type": "object",
      "required": [
        "total_paragraphs",
        "total_concepts_received",
        "total_concepts_analyzed",
        "total_categories",
        "total_relationships"
      ],
      "properties": {
        "total_paragraphs": {"type": "integer", "minimum": 0},
        "total_concepts_received": {"type": "integer", "minimum": 0},
        "total_concepts_analyzed": {"type": "integer", "minimum": 0},
        "total_categories": {"type": "integer", "minimum": 0},
        "total_relationships": {"type": "integer", "minimum": 0}
      }
    },
    "concept_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "concept_id",
          "paragraph_id",
          "original_concept",
          "suggested_concept",
          "concept_validity",
          "concept_change_required",
          "concept_reason",
          "original_code",
          "suggested_code",
          "code_evaluation",
          "code_reason",
          "evidence",
          "confidence",
          "needs_researcher_review"
        ],
        "properties": {
          "concept_id": {"type": "string", "minLength": 1},
          "paragraph_id": {"type": "string", "minLength": 1},
          "original_concept": {"type": "string"},
          "suggested_concept": {"type": "string"},
          "concept_validity": {"enum": ["valid", "questionable", "unsupported"]},
          "concept_change_required": {"type": "boolean"},
          "concept_reason": {"type": "string"},
          "original_code": {"type": "string"},
          "suggested_code": {"type": "string", "minLength": 1},
          "code_evaluation": {"enum": ["confirmed", "revise", "uncertain"]},
          "code_reason": {"type": "string"},
          "evidence": {"$ref": "#/$defs/evidence"},
          "confidence": {"$ref": "#/$defs/confidence"},
          "needs_researcher_review": {"type": "boolean"}
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category_id",
          "category_name",
          "definition",
          "category_reason",
          "concept_ids",
          "properties",
          "dimensions",
          "evidence",
          "confidence",
          "needs_researcher_review"
        ],
        "properties": {
          "category_id": {"type": "string", "minLength": 1},
          "category_name": {"type": "string", "minLength": 1},
          "definition": {"type": "string"},
          "category_reason": {"type": "string"},
          "concept_ids": {"type": "array", "items": {"type": "string"}},
          "properties": {"type": "array"},
          "dimensions": {"type": "array"},
          "evidence": {"$ref": "#/$defs/evidence"},
          "confidence": {"$ref": "#/$defs/confidence"},
          "needs_researcher_review": {"type": "boolean"}
        }
      }
    },
    "central_phenomenon": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "category_id",
            "title",
            "definition",
            "selection_reason",
            "supporting_category_ids",
            "supporting_concept_ids",
            "evidence",
            "alternative_interpretations",
            "confidence",
            "needs_researcher_review"
          ],
          "properties": {
            "category_id": {"type": ["string", "null"]},
            "title": {"type": ["string", "null"]},
            "definition": {"type": "string"},
            "selection_reason": {"type": "string"},
            "supporting_category_ids": {"type": "array", "items": {"type": "string"}},
            "supporting_concept_ids": {"type": "array", "items": {"type": "string"}},
            "evidence": {"$ref": "#/$defs/evidence"},
            "alternative_interpretations": {"type": "array"},
            "confidence": {"$ref": "#/$defs/confidence"},
            "needs_researcher_review": {"type": "boolean"}
          }
        }
      ]
    },
    "paradigm_model": {
      "type": "object",
      "required": [
        "causal_conditions",
        "central_phenomenon",
        "contextual_conditions",
        "intervening_conditions",
        "action_interaction_strategies",
        "consequences"
      ],
      "properties": {
        "causal_conditions": {"type": "array"},
        "central_phenomenon": {"type": ["object", "null"]},
        "contextual_conditions": {"type": "array"},
        "intervening_conditions": {"type": "array"},
        "action_interaction_strategies": {"type": "array"},
        "consequences": {"type": "array"}
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relationship_id",
          "source_category_id",
          "target_category_id",
          "relationship_type",
          "description",
          "supporting_concept_ids",
          "evidence",
          "confidence",
          "needs_researcher_review"
        ],
        "properties": {
          "relationship_id": {"type": "string", "minLength": 1},
          "source_category_id": {"type": "string", "minLength": 1},
          "target_category_id": {"type": "string", "minLength": 1},
          "relationship_type": {"enum": ["direct", "interpretive", "hypothetical"]},
          "description": {"type": "string", "minLength": 1},
          "supporting_concept_ids": {"type": "array", "items": {"type": "string"}},
          "evidence": {"$ref": "#/$defs/evidence"},
          "confidence": {"$ref": "#/$defs/confidence"},
          "needs_researcher_review": {"type": "boolean"}
        }
      }
    },
    "diagram": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node_id", "node_type", "title", "description", "category_ids", "concept_ids"],
            "properties": {
              "node_id": {"type": "string", "minLength": 1},
              "node_type": {
                "enum": ["causal", "phenomenon", "contextual", "intervening", "strategy", "consequence", "category"]
              },
              "title": {"type": "string"},
              "description": {"type": "string"},
              "category_ids": {"type": "array", "items": {"type": "string"}},
              "concept_ids": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["edge_id", "source", "target", "relationship_type", "label", "concept_ids", "needs_researcher_review"],
            "properties": {
              "edge_id": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "target": {"type": "string", "minLength": 1},
              "relationship_type": {"enum": ["direct", "interpretive", "hypothetical"]},
              "label": {"type": "string"},
              "concept_ids": {"type": "array", "items": {"type": "string"}},
              "needs_researcher_review": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "researcher_review": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_type", "item_id", "issue", "reason", "suggested_action"],
        "properties": {
          "item_type": {"enum": ["concept", "category", "relationship", "paradigm"]},
          "item_id": {"type": "string"},
          "issue": {"type": "string"},
          "reason": {"type": "string"},
          "suggested_action": {"type": "string"}
        }
      }
    },
    "quality_audit": {
      "type": "object",
      "required": [
        "all_concepts_processed",
        "all_ids_preserved",
        "all_evidence_verifiable",
        "unsupported_relationships_detected",
        "contradictions_detected",
        "missing_data_detected",
        "analysis_limitations",
        "final_status"
      ],
      "properties": {
        "all_concepts_processed": {"type": "boolean"},
        "all_ids_preserved": {"type": "boolean"},
        "all_evidence_verifiable": {"type": "boolean"},
        "unsupported_relationships_detected": {"type": "boolean"},
        "contradictions_detected": {"type": "boolean"},
        "missing_data_detected": {"type": "boolean"},
        "analysis_limitations": {"type": "array", "items": {"type": "string"}},
        "final_status": {"enum": ["complete", "incomplete"]}
      }
    }
  },
  "$defs": {
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["paragraph_id", "exact_quote", "interpretation"],
        "properties": {
          "paragraph_id": {"type": "string", "minLength": 1},
          "exact_quote": {"type": "string", "minLength": 1},
          "interpretation": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "additionalProperties": false
}
